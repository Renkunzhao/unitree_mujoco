<mujoco>
  <worldbody>
    <body name="grid" pos="0 0 .05">
    <!-- note: body pos cheater estimator in DapcController.cpp has to be modified when spacing & radius change -->
    <!-- 10 10 .28 .28 ;  20 5 .29 .28 ; -->
      <flexcomp type="grid" name="trampoline3d" mass="100" rgba="0.5 0.5 0.5 0.65"
                dim="3" count="20 5 2" spacing=".29 .28 .1" radius=".02">
        <!-- solref 刚度和阻尼
          +: (timeconst,dampratio); 
          -: (−stiffness,−damping) -->
        <contact condim="3" solref="0.005 1" solimp=".95 .99 .0001 0.5 2"/>
        <edge equality="false" damping="20"/>
        <elasticity young="1e5" poisson="0" damping="0.0001" thickness="0.2"/>

        <!-- <pin gridrange="0 0 0  0 0 1"/>
        <pin gridrange="9 0 0  9 0 1"/>
        <pin gridrange="0 9 0  0 9 1"/>
        <pin gridrange="9 9 0  9 9 1"/> -->
      </flexcomp>
    </body>

    <body name="disc" pos="0 2 .05">
      <flexcomp type="disc" count="9 9 1" spacing=".2 .2 .2" 
                radius=".02" mass="0.2" name="plate" dim="2">
        <contact condim="3" conaffinity="3" contype="3" solref="0.02 1" solimp=".8 .9 .001"/>
        <edge equality="true" damping="10"/>
      </flexcomp> 
    </body>
  </worldbody>
</mujoco>