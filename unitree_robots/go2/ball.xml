<mujoco model="ball">

  <worldbody>
    <body name="foot" pos="0 0 1">
      <freejoint/>
      <inertial diaginertia="9.600000000000001e-06 9.600000000000001e-06 9.600000000000001e-06" mass="4.02" pos="0 0 0"/>
      <body name="dummy_foot" pos="0 0 0">
        <inertial diaginertia="1e-14 1e-14 1e-14" mass="1e-6" pos="0 0 0"/>
        <geom name="foot_geom" size="0.022" pos="0 0 0" priority="1" condim="6" contype="1" conaffinity="1" friction="0.4 0.02 0.01" group="3"/>
        <site name="foot_sensor" size="0.025" pos="0 0 0" type="sphere"/>
        <site name="foot_force"  size="0.017" pos="0 0 0" type="sphere"/>
      </body>
    </body>
  </worldbody>

  <sensor>
    <touch name="foot_touch" site="foot_sensor"/>
    <force name="foot_force" site="foot_force"/>
    <framequat name="foot_quat" objtype="site" objname="foot_force"/>
    <framepos name="foot_pos" objtype="site" objname="foot_sensor" />
    <framelinvel name="foot_linvel" objtype="site" objname="foot_sensor" />
    <contact name="foot_contact" geom1="foot_geom" data="force" reduce="netforce"/>
  </sensor>

</mujoco>
