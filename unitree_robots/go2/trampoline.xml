    <flexcomp name="trampoline" pos="0 0 .4"
              type="disc"  dim="2" count="9 9 1" spacing=".4 .4 .4" radius=".1"
              mass="196"
              >
      <pin range="0 8 72 80"/>
      <pin id="9 17 18 26 27 35 36 44 45 53 54 62 63 71"/>
      <edge equality="true" solref="0.01 1" solimp="0.8 0.9 0.001 0.1 6"/>

