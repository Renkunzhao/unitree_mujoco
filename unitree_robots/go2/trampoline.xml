  <!-- params that affect trampoline soft behavior: type dim count spacing radius dof mass-->
  <!-- selfcollide="none" is needed when set dof="trilinear" -->
  <!-- pins are not supported for bending -->
  <!-- elasticity and edge constraint can't both be present -->
  <!-- 3.2.7 don't support dof in flexcomp -->
