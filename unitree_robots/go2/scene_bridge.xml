<mujoco model="go2 bridge camera scene">
  <include file="go2.xml"/>

  <statistic center="2.0 0 0.5" extent="6.0"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 3.0" dir="0 0 -1" directional="true"/>

    <!-- Low catch floor below the bridge.  It is intentionally below the camera
      prior's height filter, so the bridge remains the local walkable surface. -->
    <geom name="floor" pos="2.0 0 0.0" size="0 0 0.05" type="plane" material="groundplane"/>

    <geom name="platform_a" type="box" size="0.4 0.35 0.15" pos="0.1 0 0.15" rgba="0.3 0.3 0.3 1"/>
    <geom name="straight_bridge" type="box" size="1.5 0.05 0.05" pos="2.0 0 0.25" rgba="0.5 0.4 0.3 1"/>
    <geom name="platform_b" type="box" size="0.4 0.35 0.15" pos="3.9 0 0.15" rgba="0.3 0.3 0.3 1"/>

  </worldbody>
</mujoco>
